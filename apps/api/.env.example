# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://conecta:conecta@localhost:55432/conecta_dev

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────
# Both secrets must be at least 64 chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-in-production-must-be-at-least-64-characters-long-aaaa
JWT_REFRESH_SECRET=change-me-in-production-must-be-at-least-64-characters-long-bbbb
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
COOKIE_SECRET=change-me-in-production-min-32-characters

# ─── Encryption ───────────────────────────────────────────────
# ENCRYPTION_KEY: exactly 32 bytes, base64-encoded (openssl rand -base64 32)
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# SEARCH_HASH_SECRET: HMAC secret for searchable hashes, min 32 chars
SEARCH_HASH_SECRET=change-me-in-production-min-32-characters

# ─── Email ────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty in dev to send via Mailpit (SMTP localhost:1025)
RESEND_API_KEY=
MAIL_FROM=noreply@conecta.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
