# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://conecta:conecta@localhost:55432/conecta_dev

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (Sprint 1) ──────────────────────────────────────────
# JWT_SECRET must be at least 32 chars, use a CSPRNG to generate in prod
JWT_SECRET=change-me-in-production-min-32-characters
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
COOKIE_SECRET=change-me-in-production-min-32-characters

# ─── Encryption (Sprint 1) ────────────────────────────────────
# ENCRYPTION_KEY: 32 bytes, base64-encoded (use `openssl rand -base64 32`)
ENCRYPTION_KEY=
# SEARCH_HASH_SECRET: HMAC secret for searchable hashes, min 32 chars
SEARCH_HASH_SECRET=change-me-in-production-min-32-characters

# ─── Email (Sprint 1) ─────────────────────────────────────────
# In dev, leave RESEND_API_KEY empty to send via Mailpit (SMTP localhost:1025)
RESEND_API_KEY=
MAIL_FROM=noreply@conecta.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
